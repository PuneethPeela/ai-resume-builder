// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String        @id @default(cuid())
  clerkId            String        @unique
  email              String        @unique
  name               String?
  imageUrl           String?
  role               String        @default("user") // "user" | "admin" | "sub_admin"
  password           String?       // encrypted password for local auth
  promotionRequested Boolean       @default(false)
  promotionRole      String?       // "admin" | "sub_admin"
  resumes            Resume[]
  chats              ChatMessage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Resume {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Untitled Resume")
  data      Json     // full ResumeFormData as JSONB
  template  String   @default("classic")
  version   Int      @default(1)
  atsScore  Int?     // cached last ATS score
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId  String?  // optional: link to specific resume context
  role      String   // "user" | "assistant"
  content   String
  language  String?  // detected language code (en, te, hi, fr, ja)
  createdAt DateTime @default(now())

  @@index([userId])
}
